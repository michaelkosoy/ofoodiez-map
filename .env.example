# Google Maps API Key
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Google Sheets ID for data
SHEET_ID=your_sheet_id_here

# Admin panel password + shared key for the keyed endpoints (/api/refresh,
# /wa/debug/*, /wa/backfill-cron, /ig/auth/*). REQUIRED — there is deliberately no
# fallback in code, so leaving this unset locks everyone out (including you) rather
# than silently accepting a password that is readable in this public repo.
# Must be the SAME value on the main app and the ofoodiez-map-1 bot service.
ADMIN_SECRET=generate_with__python3_-c_"import secrets;print(secrets.token_urlsafe(32))"

# Formspree Endpoint for submissions
FORMSPREE_ENDPOINT=your_formspree_endpoint_here

# ---- Instagram Automation ----
# Create a Meta App at https://developers.facebook.com
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret

# Random string for webhook verification (must match what you set in Meta App Dashboard)
WEBHOOK_VERIFY_TOKEN=ofoodiez_ig_verify_2025

# Your server's public URL (needed for OAuth callback and webhooks)
BASE_URL=https://your-server-domain.com

# Flask secret key for sessions
SECRET_KEY=change-me-to-a-random-string

# Database URL for Instagram automation (defaults to SQLite)
IG_DATABASE_URL=sqlite:///instagram_automation.db

# ---- Telegram Bot Content Management ----
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_USER_ID=your_telegram_user_id_here
GEMINI_API_KEY=your_gemini_api_key_here

# ---- AI CV Reviewer / Optimizer (/hitech/cv-review) ----
# Production model — env-overridable; benchmark alternatives with
# scripts/cv_eval.py before changing (the eval suite is the judge).
# PRODUCTION REQUIREMENT: the Google AI project behind GEMINI_API_KEY must be
# on the PAID tier — CVs are personal data and must be processed under the
# paid service data terms, never free-tier.
GEMINI_CV_MODEL=gemini-3.5-flash-lite
# The reviewer is PUBLIC (no password). The shared-password gate is dormant in
# the code — set CV_REVIEW_PASSWORD_ENABLED=1 to re-close it, and then
# CV_REVIEW_PASSWORD is the code visitors must enter.
CV_REVIEW_PASSWORD_ENABLED=
CV_REVIEW_PASSWORD=123456
# Spend guard for a public, pay-per-use feature: whole-site cap per rolling 24h
# (each review costs ~$0.034 of Gemini). 0 = unlimited. Per-IP limit is 5/hour.
CV_REVIEW_DAILY_CAP=200
# Reviews without talent-pool consent are purged after this many days (0 = keep).
CV_REVIEW_RETENTION_DAYS=180
# Optional Google Drive mirror of review files (service-account JSON — the
# raw JSON string or a file path — plus the parent folder id). Unset = DB only.
# The service account needs edit access to that folder; files are NEVER shared
# publicly by the app.
GOOGLE_DRIVE_CREDENTIALS_JSON=
GOOGLE_DRIVE_CV_FOLDER_ID=

# ---- Talent Inbox (/admin/talent) ----
# Gmail CV ingestion over IMAP (read-only). Create an App Password at
# https://myaccount.google.com/apppasswords. Unset = Sync disabled; manual
# uploads and everything else still work.
TALENT_GMAIL_USER=
TALENT_GMAIL_APP_PASSWORD=
TALENT_GMAIL_FOLDER=INBOX
TALENT_SYNC_DAYS=30
# CHEAP models on purpose (structured extraction/classification only) — uses
# the same GEMINI_API_KEY as the CV reviewer (paid-tier project in prod).
GEMINI_CV_EXTRACTION_MODEL=gemini-3.5-flash-lite
GEMINI_CV_MATCHING_MODEL=gemini-3.5-flash-lite
# Optional second-try model when a call fails outright. Empty = DISABLED
# (default) for predictable costs.
GEMINI_CV_FALLBACK_MODEL=
# Outbound referral emails reuse the site transport: BREVO_API_KEY + WA_FROM_EMAIL.
# Personal Drive copy of every incoming CV (best-effort mirror; Postgres stays
# the durable store). Needs GOOGLE_DRIVE_CREDENTIALS_JSON (same as CV reviewer);
# unset folder = fall back to GOOGLE_DRIVE_CV_FOLDER_ID, both unset = no mirror.
TALENT_DRIVE_FOLDER_ID=
# Scheduled ingestion auth. Two endpoints accept a key:
#   POST /admin/api/talent/sync    - server pulls Gmail over IMAP
#   POST /admin/api/talent/ingest  - an external routine pushes one CV email
# Either ADMIN_SECRET or (preferred for anything stored in an EXTERNAL
# scheduler's config) TALENT_INGEST_TOKEN, sent as ?key=, X-Admin-Key or
# X-Ingest-Token. The narrow token unlocks CV ingestion ONLY - never the admin
# panel - so a leak there can't take over /admin. Unset both = nobody is
# authorized (fails closed). Generate one with:
#   python3 -c "import secrets;print(secrets.token_urlsafe(32))"
TALENT_INGEST_TOKEN=

# ---- WhatsApp Referral Bot (Twilio) ----
# Twilio account Auth Token — validates inbound webhook signatures (RequestValidator).
# Keep it ONLY in this gitignored .env locally and in the Render env in prod.
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# The exact public webhook URL Twilio posts to (PINNED — used for signature validation).
TWILIO_WEBHOOK_URL=https://ofoodiez-map.onrender.com/wa/webhook
